{
  "mcpServers": {
    "visiopatch": {
      "command": "/bin/bash",
      "args": ["-c", "env -u PYTHONPATH exec /absolute/path/to/visiopatch/.venv/bin/python -m visiopatch.mcp_server"],
      "cwd": "/absolute/path/to/visiopatch",
      "env": {
        "VISIOPATCH_ANALYZE_MODEL": "muse-spark-1.3",
        "VISIOPATCH_DIAGNOSE_MODEL": "muse-wonder-1.0",
        "VISIOPATCH_REPAIR_MODEL": "muse-spark-1.3",
        "VISIOPATCH_REPAIR_EFFORT": "medium"
      }
    }
  }
}
